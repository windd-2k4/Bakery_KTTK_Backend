PORT=3001
NODE_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-this

# Đổi tên database từ 'bakery_auth_db' thành 'bakery_db' cho khớp với Docker
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USERNAME=auth_service_user
AUTH_DB_PASSWORD=auth_service_pass
AUTH_DB_DATABASE=bakery_db
AUTH_DB_SCHEMA=public
AUTH_DATABASE_URL=postgresql://auth_service_user:auth_service_pass@localhost:5432/bakery_db

# Thành phần fallback giữ nguyên
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=bakery_user
DB_PASSWORD=bakery_pass
DB_DATABASE=bakery_db
DATABASE_URL=postgresql://bakery_user:bakery_pass@localhost:5432/bakery_db