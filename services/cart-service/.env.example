PORT=3006
NODE_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-this

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=bakery_user
DB_PASSWORD=bakery_pass
DB_DATABASE=bakery_db
DATABASE_URL=postgresql://bakery_user:bakery_pass@localhost:5432/bakery_db

REDIS_URL=redis://127.0.0.1:6379

# Inter-service integration
PRODUCT_SERVICE_URL=http://127.0.0.1:3002
REVIEW_SERVICE_URL=http://127.0.0.1:3007
RABBITMQ_URL=amqp://bakery_user:bakery_pass@127.0.0.1:5672

# Optional: verify user exists via review-service GET /internal/users/:id
USER_VERIFY_ENABLED=false

# Required for service-to-service internal routes
INTERNAL_API_KEY=change-this-internal-key
