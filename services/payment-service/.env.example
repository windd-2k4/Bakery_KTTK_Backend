PORT=3004
NODE_ENV=development

# Database shared with bakery_db inside Docker network
DB_HOST=bakery_db
DB_PORT=5432
DB_USERNAME=bakery_user
DB_PASSWORD=bakery_pass
DB_DATABASE=bakery_db
DATABASE_URL=postgresql://bakery_user:bakery_pass@bakery_db:5432/bakery_db

# Payment service will look up real orders from order-service
ORDER_SERVICE_URL=http://localhost:3003

# RabbitMQ
RABBITMQ_URL=amqp://bakery_user:bakery_pass@localhost:5672
RABBITMQ_PAYMENT_EXCHANGE=bakery.events
RABBITMQ_PAYMENT_QUEUE=bakery.payment.queue

# Stripe
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_BASE_URL=https://checkout.stripe.com/c/pay
STRIPE_WEBHOOK_ENDPOINT=/payments/api/webhooks/stripe

# SePay
SEPAY_API_KEY=your_sepay_api_key
SEPAY_WEBHOOK_TOKEN=your_sepay_webhook_token
SEPAY_ACCOUNT_NO=0123456789
SEPAY_ACCOUNT_NAME=BAKERY KTTK
SEPAY_BANK_CODE=970422
SEPAY_WEBHOOK_ENDPOINT=/payments/api/webhooks/sepay

# VNPAY
VNPAY_TMN_CODE=URXXXXXX
VNPAY_SECRET_KEY=ABCDE...
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3004/payments/api/callback/vnpay
VNPAY_WEBHOOK_ENDPOINT=/payments/api/callback/vnpay
