PORT=3002
NODE_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-this

# Cấu hình chuẩn trỏ chung về một database vật lý theo thiết kế 
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432
PRODUCT_DB_USERNAME=bakery_user
PRODUCT_DB_PASSWORD=bakery_pass
PRODUCT_DB_DATABASE=bakery_db
PRODUCT_DB_SCHEMA=public
PRODUCT_DATABASE_URL=postgresql://bakery_user:bakery_pass@localhost:5432/bakery_db

# Backward-compatible fallback (optional)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=bakery_user
DB_PASSWORD=bakery_pass
DB_DATABASE=bakery_db
DATABASE_URL=postgresql://bakery_user:bakery_pass@localhost:5432/bakery_db