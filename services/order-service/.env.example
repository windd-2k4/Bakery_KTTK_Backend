PORT=3003
NODE_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-this

ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432
ORDER_DB_USERNAME=order_service_user
ORDER_DB_PASSWORD=order_service_pass
ORDER_DB_DATABASE=bakery_order_db
ORDER_DB_SCHEMA=public
ORDER_DATABASE_URL=postgresql://order_service_user:order_service_pass@localhost:5432/bakery_order_db

# RabbitMQ (for order events)
RABBITMQ_URL=amqp://bakery_user:bakery_pass@localhost:5672

# Inter-service sync endpoints
PRODUCT_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001

# Backward-compatible fallback (optional)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=bakery_user
DB_PASSWORD=bakery_pass
DB_DATABASE=bakery_db
DATABASE_URL=postgresql://bakery_user:bakery_pass@localhost:5432/bakery_db
